---
pagination:
  data: pages
  size: 1
  alias: page
permalink: "{% if page.slug == 'home' %}index.html{% else %}{{ page.slug }}/index.html{% endif %}"
eleventyComputed:
  title: "{{ page.seo.title }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.seo.title }}</title>
    {%- if page.seo.description %}
    <meta name="description" content="{{ page.seo.description }}">
    {%- endif %}
    <meta property="og:title" content="{{ page.seo.ogTitle or page.seo.title }}">
    {%- if page.seo.description %}
    <meta property="og:description" content="{{ page.seo.ogDescription or page.seo.description }}">
    {%- endif %}
    <meta property="og:type" content="website">
    {%- if page.seo.url %}
    <meta property="og:url" content="{{ page.seo.url }}">
    <link rel="canonical" href="{{ page.seo.url }}">
    {%- endif %}
    <meta name="author" content="Spencer Flaherty">
    <meta name="generator" content="Eleventy">
    {%- if page.seo.ogImage %}
    <meta property="og:image" content="{{ page.seo.ogImage | absUrl(site.url) }}">
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page.seo.twitterTitle or page.seo.title }}">
    {%- if page.seo.description %}
    <meta name="twitter:description" content="{{ page.seo.twitterDescription or page.seo.description }}">
    {%- endif %}
    {%- if page.seo.ogImage %}
    <meta name="twitter:image" content="{{ (page.seo.twitterImage or page.seo.ogImage) | absUrl(site.url) }}">
    {%- endif %}
    <link rel="icon" type="image/png" href="{{ site.branding.faviconSrc or '/static/collections/shared/spencer-flaherty-site-logo-april-22.png' }}">
    <link rel="apple-touch-icon" href="{{ site.branding.faviconSrc or '/static/collections/shared/spencer-flaherty-site-logo-april-22.png' }}">
    <link rel="preload" href="/static/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin>
    <style>
      :root {
        --padding-above-logo: {{ site.layout.paddingAboveLogo or "30px" }};
        --padding-below-logo: {{ site.layout.paddingBelowLogo or "20px" }};
        --padding-below-window: {{ site.layout.paddingBelowWindow or "60px" }};
        --window-width-desktop: {{ site.layout.windowWidthDesktop or "800px" }};
        --window-width-mobile: {{ site.layout.windowWidthMobile or "100%" }};
        --h1-margin-top: {{ site.layout.spacing.h1MarginTop or "0px" }};
        --h1-margin-bottom: {{ site.layout.spacing.h1MarginBottom or "0px" }};
        --h2-margin-top: {{ site.layout.spacing.h2MarginTop or "10px" }};
        --h2-margin-bottom: {{ site.layout.spacing.h2MarginBottom or "5px" }};
        --dropdown-margin-bottom: {{ site.layout.spacing.dropdownMarginBottom or "2px" }};
      }
    </style>
    <style>{% include "styles.css" %}</style>
</head>

<body>
    <header class="site-header">
        <a href="{{ site.layout.logoLinkUrl or site.url }}" aria-label="{{ site.branding.homeAriaLabel or 'Spencer Flaherty home' }}">
            <img src="{{ site.branding.logoDesktopSrc or '/static/collections/shared/spencer-flaherty-site-logo-april-22.png' }}" alt="{{ site.branding.logoAlt or 'Spencer Flaherty' }}" class="logo-desktop" width="{{ site.branding.logoDesktopWidth or 223 }}" height="{{ site.branding.logoDesktopHeight or 180 }}">
            <img src="{{ site.branding.logoMobileSrc or '/static/collections/shared/spencer-flaherty-site-logo-april-22.png' }}" alt="{{ site.branding.logoAlt or 'Spencer Flaherty' }}" class="logo-mobile" width="{{ site.branding.logoMobileWidth or 180 }}" height="{{ site.branding.logoMobileHeight or 145 }}">
        </a>
    </header>
    <div class="window-container">
    <div class="window-frame">
        <div class="window-header">
            <div class="traffic-lights">
                <span class="light red"></span>
                <span class="light yellow"></span>
                <span class="light green"></span>
            </div>
            <div class="window-title">{{ page.windowTitle }}</div>
            <div class="theme-toggle-container">
                <span class="toggle-label">B/W</span>
                <button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch theme" aria-pressed="false">
                    <span class="toggle-knob"></span>
                </button>
            </div>
        </div>
        <div class="terminal-screen terminal-loading"><span id="terminal-text"></span><span class="user-input" id="user-input-display"></span><span class="typed-cursor" id="cursor"></span><span id="press-enter"></span><form id="mobile-form" action="javascript:void(0);"><input type="text" inputmode="numeric" enterkeyhint="go" id="mobile-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></form></div>
    </div>
    </div>

    <script>
        window.__TERMINAL_DATA__ = {
            dropdownBodyContent: {{ page | buildDropdownBodies | jsonify | safe }},
            contentSegments: {{ page | buildSegments | jsonify | safe }},
            navigationLinks: {{ page._navLinks | jsonify | safe }},
            typeSpeed: {{ site.terminal.typeSpeed or 5 }},
            initialDelayMs: {{ site.terminal.initialDelayMs or 500 }}
        };
    </script>
    <script defer src="/static/js/terminal.js"></script>
</body>
</html>
